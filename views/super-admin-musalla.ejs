<%- include('partials/head',{title:`Edit ${musalla.name}`,canonicalPath:`/m/${musalla.guid}`}) %>
<%- include('partials/nav') %>
<main>
  <a class="back" href="/super-admin">‹ All Musallas</a>
  <header class="page-head">
<p class="eyebrow">SUPER ADMIN</p>
<h1>Edit Musalla</h1>
<p>Update this Musalla's platform record.</p>
</header>
  <form id="musalla-notifications-form" action="/super-admin/musallas/<%= musalla.id %>/notifications" method="post"></form>
  <form action="/super-admin/musallas/<%= musalla.id %>" method="post" enctype="multipart/form-data" class="surface stack">
<label>Logo<% if(musalla.logo_url){ %>
<a href="/m/<%= musalla.guid %>" aria-label="View <%= musalla.name %>">
<img class="logo-preview" src="<%= musalla.logo_url %>" alt="Current <%= musalla.name %> logo">
</a>
<% } %>
<input name="logo" type="file" accept="image/png,image/jpeg,image/webp,image/gif">
<small>PNG, JPG, WebP, or GIF. Maximum 2 MB.</small>
</label>
<label>Name<input name="name" required maxlength="150" value="<%= musalla.name %>">
</label>
<fieldset class="profile-fieldset"><legend>Public address</legend>
<label>Street address<input name="street_address" required maxlength="200" value="<%= musalla.street_address || '' %>"></label>
<label>City<input name="address_locality" required maxlength="120" value="<%= musalla.address_locality || '' %>"></label>
<div class="profile-field-grid"><label>State or region<input name="address_region" maxlength="120" value="<%= musalla.address_region || '' %>"></label><label>Postal code<input name="postal_code" maxlength="24" value="<%= musalla.postal_code || '' %>"></label></div>
<label>Country<input name="address_country" required maxlength="100" value="<%= musalla.address_country || '' %>"></label>
</fieldset>
<label>Public description
<textarea name="about" required maxlength="3000" rows="6">
<%= musalla.about || '' %>
</textarea>
<small>This description appears on the public Musalla page.</small>
</label>
<label>Facilities <span class="optional-label">Optional</span>
<textarea name="facilities" maxlength="2000" rows="4" placeholder="Parking&#10;Wudu facilities&#10;Women’s prayer area"><%= musalla.facilities || '' %></textarea>
<small>Enter one facility per line.</small>
</label>
<label>Website <span class="optional-label">Optional</span><input name="website_url" type="url" value="<%= musalla.website_url || '' %>" placeholder="https://..."></label>
<div class="profile-field-grid"><label>Public email <span class="optional-label">Optional</span><input name="public_email" type="email" maxlength="320" value="<%= musalla.public_email || '' %>"></label><label>Public phone <span class="optional-label">Optional</span><input name="public_phone" type="tel" maxlength="40" value="<%= musalla.public_phone || '' %>"></label></div>
<label>Prayer timetable or app link<input name="timetable_url" type="url" value="<%= musalla.timetable_url %>" placeholder="https://...">
<small>This link appears on the Musalla roster.</small>
</label>
<input name="timezone" type="hidden" value="<%= musalla.timezone %>">
<label class="toggle-setting"><span><b>Enable notifications</b><small>Allow email notifications for this Musalla. Changes save immediately.</small></span><input type="checkbox" name="notifications_enabled" value="1" form="musalla-notifications-form" onchange="this.form.submit()" <%= Number(musalla.notifications_enabled)===1?'checked':'' %>></label>
<details class="settings-panel">
<summary><span>Salah slots</span><small>Daily opt-in slots</small></summary>
<div class="settings-panel-content">
<p>Choose which daily Salah slots appear on the schedule for Imam opt-in.</p>
<% ['Fajr','Zuhr','Asr','Maghrib','Isha'].forEach(prayer => { const field=`${prayer.toLowerCase()}_enabled`; %>
<label class="toggle-setting"><span><b><%= prayer %></b><small>Show this slot on the schedule</small></span><input type="checkbox" name="<%= field %>" value="1" <%= musalla[field]?'checked':'' %>></label>
<% }) %>
</div>
</details>
<details class="settings-panel">
<summary>
<span>Jumuah</span>
<small>Friday prayer slots</small>
</summary>
<div class="settings-panel-content">
<p>Enable up to three Jumuah slots. On Fridays, enabled slots replace Zuhr on the imam roster.</p>
<% [1,2,3].forEach(number => { %>
<label class="toggle-setting">
<span>
<b>Jumuah <%= number %>
</b>
<small>Show this slot on Fridays</small>
</span>
<input type="checkbox" name="jumuah_<%= number %>_enabled" value="1" <%= musalla[`jumuah_${number}_enabled`]?'checked':'' %>>
</label>
<% }) %>
</div>
</details>
<button class="button">Save Musalla</button>
</form>
  <% if(requests.length){ %>
    <section class="surface super-members">
      <h2>Membership requests</h2>
      <% if(needsInitialAdmin){ %>
        <p>The Musalla does not have an administrator yet. Approve its first member and assign the Imam role, Administrator role, or both.</p>
      <% } else { %>
        <p>As a super admin, you can approve or deny any pending request for this Musalla. Leave both roles unchecked to approve someone as a Member.</p>
      <% } %>
      <% requests.forEach(request=>{ const requestProfileUrl=`/super-admin/musallas/${musalla.id}/members/${request.id}/profile`; %>
        <div class="membership-request initial-approval">
          <div class="member-summary"><a class="member-avatar-link" href="<%= requestProfileUrl %>" aria-label="View <%= request.name %>'s profile"><span class="mini-avatar"><% if(request.avatar_url){ %><img src="<%= request.avatar_url %>" alt=""><% } else { %><%= request.name[0] %><% } %></span></a><div><a class="member-name" href="<%= requestProfileUrl %>"><%= request.name %></a><small><%= request.email %></small></div></div>
          <div class="request-actions">
            <form action="/super-admin/musallas/<%= musalla.id %>/membership-requests/<%= request.id %>/approve" method="post" class="stack" data-confirm-title="Approve <%= request.name %>?" data-confirm="This membership will be activated with the selected roles." data-confirm-button="Approve membership">
              <div class="role-options">
                <label class="role-option">
<input type="checkbox" name="roles" value="imam" <%= request.requested_role==='imam'?'checked':'' %>> Imam</label>
                <label class="role-option">
<input type="checkbox" name="roles" value="admin"> Administrator</label>
              </div>
              <div class="initial-action-buttons">
                <button class="button chip approve">Approve membership</button>
                <button class="button chip danger" type="submit" formaction="/super-admin/musallas/<%= musalla.id %>/membership-requests/<%= request.id %>/deny" data-confirm-title="Deny <%= request.name %>?" data-confirm="This membership request will be denied." data-confirm-button="Deny request" data-confirm-style="danger">Deny</button>
              </div>
            </form>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>
  <section class="surface super-members">
<h2>Members</h2>
<% members.forEach(member=>{ %>
<a class="super-member" href="/super-admin/musallas/<%= musalla.id %>/members/<%= member.id %>/profile">
<span>
<b>
<%= member.name %>
</b>
<small>
<%= member.email %> · <%= member.role.split(',').join(' · ') %>
</small>
</span>
<b>›</b>
</a>
<% }) %>
<% if(!members.length){ %>
<div class="empty">No members.</div>
<% } %>
</section>
  <%- include('partials/add-member-form',{addMemberAction:`/super-admin/musallas/${musalla.id}/members/add`}) %>
</main>
<script src="/members.js?v=5"></script>
<%- include('partials/foot') %>
