<% if(user && !hideNavigation){ %>
  <nav class="bottom-nav">
    <% if(superAdminMode){ %>
      <a class="<%= path.startsWith('/super-admin')?'active':'' %>" href="/super-admin"><span class="nav-icon">⚙<% if(typeof superAdminPendingCount!=='undefined'&&superAdminPendingCount){ %><b class="nav-badge"><%= superAdminPendingCount %></b><% } %></span>Super Admin<% if(typeof superAdminPendingCount!=='undefined'&&superAdminPendingCount){ %><span class="sr-only"><%= superAdminPendingCount %> pending membership request<%= superAdminPendingCount===1?'':'s' %></span><% } %></a>
      <% if(canSwitchToMember){ %><form action="/view-mode" method="post"><input type="hidden" name="mode" value="member"><button><span>⇄</span>Musalla Role</button></form><% } %>
      <a class="<%= path==='/profile'?'active':'' %>" href="/profile"><span>♙</span>Profile</a>
    <% } else { %>
      <a class="<%= path==='/'?'active':'' %>" href="/"><span>⌂</span>Home</a>
      <% if(musallaNav){ %><a class="<%= path===`/musallas/${musallaNav.id}`?'active':'' %>" href="/musallas/<%= musallaNav.id %>"><span aria-hidden="true">▦</span>Schedule</a><% } else { %><a class="<%= path==='/membership-requests'?'active':'' %>" href="/membership-requests"><span>＋</span>Join</a><% } %>
      <% if(musallaNav&&canManageMembers){ %><a class="<%= path===`/musallas/${musallaNav.id}/members`?'active':'' %>" href="/musallas/<%= musallaNav.id %>/members"><span class="nav-icon" aria-hidden="true">👥<% if(pendingApprovalCount){ %><b class="nav-badge"><%= pendingApprovalCount %></b><% } %></span>Members<% if(pendingApprovalCount){ %><span class="sr-only"><%= pendingApprovalCount %> pending approval<%= pendingApprovalCount===1?'':'s' %></span><% } %></a><% } %>
      <% if(user.is_superuser){ %><form action="/view-mode" method="post"><input type="hidden" name="mode" value="super"><button><span>⚙</span>Super Admin</button></form><% } %>
      <a class="<%= path==='/profile'?'active':'' %>" href="/profile"><span>♙</span>Profile</a>
    <% } %>
  </nav>
<% } %>
<dialog class="confirmation-dialog" id="confirmation-dialog"><div class="dialog-card"><button class="dialog-close" id="confirmation-close" type="button" aria-label="Close">×</button><p class="eyebrow">PLEASE CONFIRM</p><h2 id="confirmation-title">Confirm membership action</h2><p id="confirmation-message"></p><div class="dialog-actions"><button class="button secondary" id="confirmation-cancel" type="button">Cancel</button><button class="button danger" id="confirmation-continue" type="button">Confirm</button></div></div></dialog>
<% const toastNotice=typeof notice!=='undefined'&&notice?(typeof notice==='string'?{message:notice,type:'success'}:notice):null; const registrationToast=typeof registrationConfirmation!=='undefined'?registrationConfirmation:null; %>
<div class="toast-region<%= user&&!hideNavigation?' has-bottom-nav':'' %>" data-toast-region aria-live="polite" aria-atomic="false">
  <% if(toastNotice){ %><div class="toast toast-<%= toastNotice.type==='error'?'error':'success' %>" data-toast data-toast-autoclose="<%= toastNotice.type==='error'?'7000':'4500' %>" role="<%= toastNotice.type==='error'?'alert':'status' %>"><span class="toast-icon" aria-hidden="true"><%= toastNotice.type==='error'?'!':'✓' %></span><span class="toast-message"><%= toastNotice.message %></span><button class="toast-close" type="button" aria-label="Dismiss notification">×</button></div><% } %>
  <% if(registrationToast){ %><div class="toast toast-success" data-toast data-toast-autoclose="6000" role="status"><span class="toast-icon" aria-hidden="true">✓</span><span class="toast-message"><strong><%= registrationToast.name %> was registered.</strong> <%= registrationToast.message %></span><button class="toast-close" type="button" aria-label="Dismiss notification">×</button></div><% } %>
</div>
<aside class="install-app-prompt" id="install-app-prompt" aria-labelledby="install-app-title" aria-describedby="install-app-message install-app-instructions" hidden>
  <button class="install-app-close" id="install-app-close" type="button" aria-label="Dismiss app installation prompt">×</button>
  <img src="/icon-192.png" alt="">
  <div class="install-app-copy">
    <span>Musalla app</span>
    <strong id="install-app-title">Install Musalla</strong>
    <p id="install-app-message">Keep weekly Salah and Jumuah schedules one tap away.</p>
    <p class="install-app-instructions" id="install-app-instructions" aria-live="polite" hidden></p>
  </div>
  <button class="button" id="install-app-button" type="button">Install app</button>
</aside>
</div>
