<%- include('partials/head',{title:musalla.name,isPublic:true,canonicalPath:`/m/${musalla.guid}`,description:musalla.about||`${musalla.name}${musalla.address?` in ${musalla.address}`:''} is part of the Musalla community.`,structuredData}) %>
<main class="public-musalla">
  <%- include('partials/public-nav') %>
  <section class="public-musalla-hero">
    <a class="mosque-icon public-musalla-logo" href="/m/<%= musalla.guid %>" aria-label="View <%= musalla.name %>"><% if(musalla.logo_url){ %><img src="<%= musalla.logo_url %>" alt="<%= musalla.name %> logo"><% } else { %>⌂<% } %></a>
    <p class="eyebrow">COMMUNITY MUSALLA</p><h1><%= musalla.name %></h1>
    <% if(musalla.address){ %><a class="public-address" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(musalla.address) %>"><%= musalla.address %></a><% } %>
  </section>
  <% if(musalla.about){ %><section class="surface public-about"><h2>About</h2><p><%= musalla.about %></p></section><% } %>
  <section class="surface public-details"><h2>Prayer information</h2><dl><div><dt>Daily salah</dt><dd><%= dailyPrayers.length?dailyPrayers.join(', '):'Contact the Musalla for its current prayer schedule' %></dd></div><div><dt>Jumuah</dt><dd><%= jumuahCount?`${jumuahCount} scheduled ${jumuahCount===1?'slot':'slots'}`:'No public Jumuah slot is currently listed' %></dd></div></dl><% if(musalla.timetable_url){ %><a class="button secondary public-timetable" href="<%= musalla.timetable_url %>" target="_blank" rel="noopener noreferrer">View prayer timetable</a><% } %></section>
  <% if(facilities.length){ %><section class="surface public-details"><h2>Facilities</h2><ul class="public-facilities"><% facilities.forEach(facility => { %><li><%= facility %></li><% }) %></ul></section><% } %>
  <% if(websiteUrl || musalla.public_email || musalla.public_phone){ %><section class="surface public-details"><h2>Website and contact</h2><div class="public-contact"><% if(websiteUrl){ %><a href="<%= websiteUrl %>" target="_blank" rel="noopener noreferrer">Visit website</a><% } %><% if(musalla.public_email){ %><a href="mailto:<%= musalla.public_email %>"><%= musalla.public_email %></a><% } %><% if(musalla.public_phone){ %><a href="tel:<%= musalla.public_phone.replace(/[^+\d]/g,'') %>"><%= musalla.public_phone %></a><% } %></div></section><% } %>
  <section class="surface public-action">
    <% if(!user){ %><h2>Join the community</h2><p>Sign in to request membership and interact with the Musalla app.</p><a class="button" href="<%= joinUrl %>">Sign in to join</a>
    <% } else if(membership?.status==='active'){ %><h2>You are a member</h2><p>Open the app to view the imam roster and participate.</p><a class="button" href="/musallas/<%= musalla.id %>">Open Musalla</a>
    <% } else if(membership?.status==='pending'){ %><h2>Request pending</h2><p>An administrator will review your membership request.</p><a class="button secondary" href="/">Go to dashboard</a>
    <% } else { %><h2>Join the community</h2><p>Request membership to interact with this Musalla in the app.</p><a class="button" href="<%= joinUrl %>">Request membership</a><% } %>
  </section>
</main>
<script src="/menu.js?v=4"></script><%- include('partials/foot') %>
