<%- include('partials/head',{title:musalla.name,canonicalPath:`/m/${musalla.guid}`}) %><%- include('partials/nav') %>
<main class="schedule-page weekly-schedule-page">
  <a class="back" href="/">‹ All musallas</a>
  <header class="musalla-head"><a class="mosque-icon big musalla-logo-link" href="/m/<%= musalla.guid %>" aria-label="View <%= musalla.name %>"><% if(musalla.logo_url){ %><img src="<%= musalla.logo_url %>" alt=""><% } else { %>⌂<% } %></a><div><p class="eyebrow"><%= isAdmin?'ADMIN VIEW':'IMAM ROSTER' %></p><div class="musalla-title"><h1><%= musalla.name %></h1><% if(isAdmin){ %><a class="profile-icon" href="/musallas/<%= musalla.id %>/profile" aria-label="Edit Musalla profile" title="Edit Musalla profile">⚙</a><% } %></div><p><%= musalla.address %></p><% if(musalla.timetable_url){ %><a class="timetable-link" href="<%= musalla.timetable_url %>" target="_blank" rel="noopener noreferrer">View prayer timetable ↗</a><% } %></div></header>
  <%
    const isoDate=value=>value.toISOString().slice(0,10);
    const addDays=(value,days)=>{ const result=new Date(value+'T12:00:00Z'); result.setUTCDate(result.getUTCDate()+days); return isoDate(result); };
    const days=Array.from({length:7},(_,index)=>addDays(date,index));
    const previousDate=addDays(date,-7)<firstDate?firstDate:addDays(date,-7);
    const nextDate=addDays(date,7)>finalWeekStart?finalWeekStart:addDays(date,7);
    const rangeFormatter=new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',timeZone:'UTC'});
    const dayFormatter=new Intl.DateTimeFormat('en-US',{weekday:'short',timeZone:'UTC'});
    const dayNumberFormatter=new Intl.DateTimeFormat('en-US',{day:'numeric',timeZone:'UTC'});
    const prayers=['Fajr','Zuhr','Asr','Maghrib','Isha'];
    const imamDisplayName=name=>{ const parts=(name||'Imam').trim().split(/\s+/); return parts.length>1?`${parts[0]} ${parts.at(-1)}`:parts[0]; };
    const offersJumuah=[1,2,3].some(number=>musalla[`jumuah_${number}_enabled`]);
    const slotsByDate=Object.fromEntries(days.map(day=>[day,slots.filter(slot=>slot.prayer_date===day)]));
    const canSchedule=canLead||isAdmin;
    const adminImams=typeof eligibleImams==='undefined'?[]:eligibleImams;
  %>
  <form class="week-picker"><button name="navigate" value="<%= previousDate %>" <%= date===firstDate?'disabled':'' %> aria-label="Previous week">‹</button><label class="date-select"><span class="date-display"><span aria-hidden="true">▣</span><%= rangeFormatter.format(new Date(date+'T12:00:00Z')) %> – <%= rangeFormatter.format(new Date(weekEndDate+'T12:00:00Z')) %></span><input type="date" name="date" aria-label="Choose week starting date" value="<%= date %>" min="<%= firstDate %>" max="<%= finalWeekStart %>" onchange="this.form.submit()"></label><button class="today-button <%= days.includes(today)?'current':'' %>" name="navigate" value="<%= today %>" aria-label="Show this week" title="This week">●</button><button name="navigate" value="<%= nextDate %>" <%= date===finalWeekStart?'disabled':'' %> aria-label="Next week">›</button></form>
  <p class="week-help"><%= isAdmin?'Tap any prayer to assign or opt out an Imam for one occurrence or weekly.':canLead?'Tap an available prayer and choose this week or weekly. Tap an assignment to change or release it.':'Prayer leadership for the next seven days.' %></p>
  <div class="weekly-table-wrap">
    <table class="weekly-table">
      <thead><tr><th scope="col">Day</th><% prayers.forEach(prayer=>{ %><th scope="col"><%= prayer %></th><% }) %></tr></thead>
      <tbody>
        <% days.forEach(day=>{ const dayDate=new Date(day+'T12:00:00Z'); %>
          <tr class="<%= day===today?'today-row':'' %>">
            <th scope="row"><span><%= dayFormatter.format(dayDate) %></span><b><%= dayNumberFormatter.format(dayDate) %></b></th>
            <% prayers.forEach(prayer=>{
              const fridayUnavailable=dayDate.getUTCDay()===5&&prayer==='Zuhr'&&!offersJumuah;
              const daySlots=fridayUnavailable?[]:slotsByDate[day].filter(slot=>prayer==='Zuhr'?(slot.prayer_name==='Zuhr'||slot.prayer_name.startsWith('Jumuah')):slot.prayer_name===prayer);
            %>
              <td class="<%= fridayUnavailable?'unavailable-slot':'' %>">
                <% daySlots.forEach(s=>{
                  const mine=Number(s.imam_user_id)===Number(user.id);
                  const canReplace=canLead&&s.imam_user_id&&!mine;
                  const isJumuah=s.prayer_name.startsWith('Jumuah');
                  const imamColor=s.imam_user_id?`imam-color-${Number(s.imam_user_id)%8}`:'';
                  const formAction=isAdmin?`/musallas/${musalla.id}/slots/${s.id}/manage`:`/musallas/${musalla.id}/slots/${s.id}/opt-in`;
                  const scheduleAction=isAdmin?(s.imam_user_id?'admin-opt-out':'admin-opt-in'):(mine?'opt-out':canReplace?'replace':canLead?'opt-in':'');
                %>
                  <form class="week-slot <%= s.imam_user_id?'claimed':'' %> <%= imamColor %>" action="<%= formAction %>" method="post" <% if(scheduleAction){ %>data-schedule-action="<%= scheduleAction %>"<% } %> <% if(s.imam_name){ %>data-imam="<%= s.imam_name %>"<% } %> data-prayer="<%= s.prayer_name %>" data-date="<%= s.prayer_date %>">
                    <input type="hidden" name="change_scope" value="<%= s.imam_user_id?'future':'occurrence' %>">
                    <input type="hidden" name="return_date" value="<%= date %>">
                    <% if(isAdmin){ %>
                      <input type="hidden" name="admin_action" value="<%= s.imam_user_id?'release':'assign' %>">
                      <% if(s.imam_user_id){ %><input type="hidden" name="assigned_imam_id" value="<%= s.imam_user_id %>"><% } %>
                    <% } else if(canReplace){ %>
                      <input type="hidden" name="replace_imam_id" value="<%= s.imam_user_id %>">
                    <% } %>
                    <button <%= !canSchedule?'disabled':'' %> aria-label="<%= isAdmin?(s.imam_name?`Opt ${s.imam_name} out of ${s.prayer_name}`:`Assign an Imam to ${s.prayer_name}`):s.imam_name?(mine?`Release your ${s.prayer_name} assignment`:`${s.imam_name} is leading ${s.prayer_name}${canReplace?'; replace assignment':''}`):canLead?`Opt in to lead ${s.prayer_name}`:`${s.prayer_name} needs an imam` %>" title="<%= isAdmin?(s.imam_name?`Manage ${s.imam_name}`:'Assign an Imam'):s.imam_name?(mine?'You are leading':`${s.imam_name} is leading`):canLead?'Opt in to lead':'Imam needed' %>">
                      <% if(isJumuah){ %><small><%= s.prayer_name.replace('Jumuah ','J') %></small><% } %><span aria-hidden="true"><%= s.imam_name?imamDisplayName(s.imam_name):canSchedule?'+':'○' %></span>
                    </button>
                  </form>
                <% }) %>
                <% if(!daySlots.length){ %><span class="slot-missing"<% if(fridayUnavailable){ %> title="No Jumuah offered" aria-label="No Friday prayer offered"<% } %>>—</span><% } %>
              </td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if(isAdmin){ %><form class="schedule-reminder" action="/musallas/<%= musalla.id %>/remind-imams" method="post" data-confirm-title="Remind active Imams?" data-confirm="Send the seven-day schedule to all active Imam members and ask them to fill open prayer slots." data-confirm-button="Send reminder"><input type="hidden" name="date" value="<%= date %>"><button class="button" type="submit"><span aria-hidden="true">◉</span> Remind Imams</button></form><% } %>
  <dialog class="opt-in-dialog" id="admin-opt-in-dialog"><form method="dialog" class="dialog-card"><button class="dialog-close" value="cancel" aria-label="Close">×</button><p class="eyebrow">ASSIGN IMAM</p><h2 id="admin-opt-in-title">Assign this prayer</h2><label>Imam<select id="admin-opt-in-imam" required><% if(!adminImams.length){ %><option value="">No active Imams available</option><% } else { %><option value="">Select an Imam</option><% adminImams.forEach(imam=>{ %><option value="<%= imam.id %>"><%= imam.name %></option><% }) %><% } %></select></label><p id="admin-opt-in-description">Choose one date or the same weekday every week.</p><div class="dialog-actions"><button class="button secondary" id="admin-opt-in-once" value="default" <%= adminImams.length?'':'disabled' %>>This day</button><button class="button" id="admin-opt-in-weekly" value="default" <%= adminImams.length?'':'disabled' %>>Every week</button></div></form></dialog>
  <dialog class="opt-in-dialog" id="admin-opt-out-dialog"><form method="dialog" class="dialog-card"><button class="dialog-close" value="cancel" aria-label="Close">×</button><p class="eyebrow">OPT OUT IMAM</p><h2 id="admin-opt-out-title">Opt out this Imam?</h2><p id="admin-opt-out-description">Choose one date or that weekday from then on.</p><label>Reason <span class="optional-label">Optional</span><textarea id="admin-opt-out-reason" rows="3" maxlength="500" placeholder="Why is this Imam no longer able to lead?"></textarea></label><div class="dialog-actions"><button class="button secondary" id="admin-opt-out-once" value="default">This day</button><button class="button" id="admin-opt-out-future" value="default">This and future weeks</button></div></form></dialog>
  <dialog class="opt-in-dialog" id="opt-in-dialog"><form method="dialog" class="dialog-card"><button class="dialog-close" value="cancel" aria-label="Close">×</button><p class="eyebrow">OPT IN</p><h2 id="opt-in-title">Lead this prayer?</h2><p id="opt-in-description">Choose one date or the same weekday every week.</p><div class="dialog-actions"><button class="button secondary" id="opt-in-once" value="default">This day</button><button class="button" id="opt-in-weekly" value="default">Every week</button></div></form></dialog>
  <dialog class="opt-in-dialog" id="change-assignment-dialog"><form method="dialog" class="dialog-card"><button class="dialog-close" value="cancel" aria-label="Close">×</button><p class="eyebrow">CHANGE IMAM</p><h2 id="change-assignment-title">Change this prayer?</h2><p id="change-assignment-description">Choose one date or that weekday from then on.</p><div class="dialog-actions"><button class="button secondary" id="change-once" value="default">This day</button><button class="button" id="change-future" value="default">This and future weeks</button></div></form></dialog>
  <dialog class="opt-in-dialog" id="opt-out-dialog"><form method="dialog" class="dialog-card"><button class="dialog-close" value="cancel" aria-label="Close">×</button><p class="eyebrow">OPT OUT</p><h2 id="opt-out-title">Release this prayer?</h2><p id="opt-out-description">Choose one date or that weekday from then on.</p><label>Reason <span class="optional-label">Optional</span><textarea id="opt-out-reason" rows="3" maxlength="500" placeholder="Why are you no longer able to lead?"></textarea></label><div class="dialog-actions"><button class="button secondary" id="opt-out-once" value="default">This day</button><button class="button" id="opt-out-future" value="default">This and future weeks</button></div></form></dialog>
</main>
<script src="/musalla.js?v=9"></script>
<%- include('partials/foot') %>
