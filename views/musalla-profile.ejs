<%- include('partials/head',{title:'Musalla profile'}) %><%- include('partials/nav') %>
<main>
  <a class="back" href="/musallas/<%= musalla.id %>">‹ Back to <%= musalla.name %></a>
  <header class="page-head"><p class="eyebrow">MUSALLA ADMIN</p><h1>Musalla profile</h1><p>Manage the details shown to your community.</p></header>
  <form id="musalla-notifications-form" action="/musallas/<%= musalla.id %>/notifications" method="post"></form>
  <form action="/musallas/<%= musalla.id %>/profile" method="post" enctype="multipart/form-data" class="surface stack">
    <label>Logo<% if(musalla.logo_url){ %><a href="/m/<%= musalla.guid %>" aria-label="View <%= musalla.name %>"><img class="logo-preview" src="<%= musalla.logo_url %>" alt="Current <%= musalla.name %> logo"></a><% } %><input name="logo" type="file" accept="image/png,image/jpeg,image/webp,image/gif"><small>PNG, JPG, WebP, or GIF. Maximum 2 MB.</small></label>
    <label>Name<input name="name" required maxlength="150" value="<%= musalla.name %>"></label>
    <fieldset class="profile-fieldset"><legend>Public address</legend>
      <label>Street address<input name="street_address" required maxlength="200" value="<%= musalla.street_address || '' %>"></label>
      <label>City<input name="address_locality" required maxlength="120" value="<%= musalla.address_locality || '' %>"></label>
      <div class="profile-field-grid"><label>State or region<input name="address_region" maxlength="120" value="<%= musalla.address_region || '' %>"></label><label>Postal code<input name="postal_code" maxlength="24" value="<%= musalla.postal_code || '' %>"></label></div>
      <label>Country<input name="address_country" required maxlength="100" value="<%= musalla.address_country || '' %>"></label>
    </fieldset>
    <label>Public description<textarea name="about" required maxlength="3000" rows="6" placeholder="Tell your community about this Musalla."><%= musalla.about || '' %></textarea><small>This description appears on the public Musalla page.</small></label>
    <label>Facilities <span class="optional-label">Optional</span><textarea name="facilities" maxlength="2000" rows="4" placeholder="Parking&#10;Wudu facilities&#10;Women’s prayer area"><%= musalla.facilities || '' %></textarea><small>Enter one facility per line.</small></label>
    <label>Website <span class="optional-label">Optional</span><input name="website_url" type="url" value="<%= musalla.website_url || '' %>" placeholder="https://..."></label>
    <div class="profile-field-grid"><label>Public email <span class="optional-label">Optional</span><input name="public_email" type="email" maxlength="320" value="<%= musalla.public_email || '' %>"></label><label>Public phone <span class="optional-label">Optional</span><input name="public_phone" type="tel" maxlength="40" value="<%= musalla.public_phone || '' %>"></label></div>
    <label>Public page<input value="/m/<%= musalla.guid %>" readonly><small><a href="/m/<%= musalla.guid %>" target="_blank">View public page</a></small></label>
    <label>Prayer timetable or app link<input name="timetable_url" type="url" value="<%= musalla.timetable_url %>" placeholder="https://..."><small>This link appears on the Musalla roster.</small></label>
    <label class="toggle-setting"><span><b>Enable notifications</b><small>Allow email notifications for this Musalla. Changes save immediately.</small></span><input type="checkbox" name="notifications_enabled" value="1" form="musalla-notifications-form" onchange="this.form.submit()" <%= Number(musalla.notifications_enabled)===1?'checked':'' %>></label>
    <details class="settings-panel">
      <summary><span>Salah slots</span><small>Daily opt-in slots</small></summary>
      <div class="settings-panel-content">
        <p>Choose which daily Salah slots appear on the schedule for Imam opt-in.</p>
        <% ['Fajr','Zuhr','Asr','Maghrib','Isha'].forEach(prayer => { const field=`${prayer.toLowerCase()}_enabled`; %>
          <label class="toggle-setting"><span><b><%= prayer %></b><small>Show this slot on the schedule</small></span><input type="checkbox" name="<%= field %>" value="1" <%= musalla[field]?'checked':'' %>></label>
        <% }) %>
      </div>
    </details>
    <details class="settings-panel">
      <summary><span>Jumuah</span><small>Friday prayer slots</small></summary>
      <div class="settings-panel-content">
        <p>Enable up to three Jumuah slots. On Fridays, enabled slots replace Zuhr on the imam roster.</p>
        <% [1,2,3].forEach(number => { %>
          <label class="toggle-setting"><span><b>Jumuah <%= number %></b><small>Show this slot on Fridays</small></span><input type="checkbox" name="jumuah_<%= number %>_enabled" value="1" <%= musalla[`jumuah_${number}_enabled`]?'checked':'' %>></label>
        <% }) %>
      </div>
    </details>
    <button class="button">Save profile</button>
  </form>
</main>
<%- include('partials/foot') %>
